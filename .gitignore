# Generated by Cargo
/target/

# Vendor directory (use cargo vendor separately)
/vendor/

# Archives and release artifacts
*.tar.gz
*.tar.xz
*.tar.zst

# Snap build artifacts
*.snap
/parts/
/stage/
/prime/

# Flatpak build artifacts
.flatpak-builder/
# `flatpak build-init` output trees. Each one writes its own .gitignore
# containing `*`, so git happens not to see them — but that is an autogenerated
# file we do not control, and without these rules 1700+ build artifacts become
# stageable the moment it changes.
build-dir/
build-flatpak/

# Debian build artifacts
/debian/.debhelper/
/debian/cargo_home/
/debian/rustconn/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Backup files
# `*.bak` alone does NOT match the numbered snapshots editors produce
# (`foo.rs.bak30`), so numbered suffixes slipped past it and got committed
# (0.23.15 removed one batch; 59 more remained). `*.bak*` covers both.
*.bak*
*~
*.our_backup

# Editor swap/temp files
*.swp
*.swo
*.po~

# Debug
*.pdb

# AppImage build artifacts
/AppDir/
*.AppImage
linuxdeploy-x86_64.AppImage
linuxdeploy-plugin-gtk.sh

# Distribution / packaging output
/dist/

# OBS (Open Build Service) checkout
/home:totoshko88:rustconn/

# Coverage
*.profraw
*.profdata
coverage/

# Logs
*.log

# Compiled gettext translations
*.mo

# Python cache
__pycache__/

# Environment secrets
.env
.env.*
.envrc

# KiroGraph index
.kirograph/

# Internal planning
ROADMAP.md

# Claude Code local configuration
.claude/

