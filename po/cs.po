msgid "Admin/console session (/admin)"
msgstr "Relace správce/konzole (/admin)"

#: rustconn/src/dialogs/connection/rdp.rs:583
msgid ""
"Connect to the console/admin session (External client). Bypasses RDS CAL "
"licensing"
msgstr ""
"Připojit k relaci konzole/správce (externí klient). Obchází licencování RDS "
"CAL"

