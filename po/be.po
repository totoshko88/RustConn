msgstr "Не ўдалося прачытаць буфер абмену"

#: rustconn/src/embedded_rdp/autotype.rs:157
msgid "Type Text into Remote Session"
msgstr "Набраць тэкст у аддаленай сесіі"

#: rustconn/src/embedded_rdp/autotype.rs:167
