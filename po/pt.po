msgstr "Sessão partilhada"

#: rustconn/src/window/network_tools/share.rs:255
#: rustconn/src/window/network_tools/share.rs:618
msgid "Copy link"
msgstr "Copiar ligação"

#: rustconn/src/window/network_tools/share.rs:256
#: rustconn/src/window/network_tools/share.rs:619
msgid "Stop sharing"
msgstr "Parar partilha"

#: rustconn/src/window/network_tools/share.rs:265
#: rustconn/src/window/network_tools/share.rs:529
