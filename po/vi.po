#: rustconn/src/embedded_rdp/connection.rs:290
msgid "Authentication failed: invalid username or password."
msgstr "Xác thực thất bại: tên người dùng hoặc mật khẩu không hợp lệ."

#: rustconn/src/embedded_rdp/connection.rs:293
msgid ""
"Access denied: you do not have permission to log on to this server via RDP."
msgstr ""
"Truy cập bị từ chối: bạn không có quyền đăng nhập vào máy chủ này qua RDP."

#: rustconn/src/embedded_rdp/connection.rs:297
msgid "Account is locked out. Wait a few minutes and try again."
msgstr "Tài khoản đang bị khóa. Hãy chờ vài phút rồi thử lại."

#: rustconn/src/embedded_rdp/connection.rs:300
msgid "Account is disabled on the server."
msgstr "Tài khoản đã bị vô hiệu hóa trên máy chủ."

#: rustconn/src/embedded_rdp/connection.rs:305
msgid "Password expired. Change the password on the server and try again."
msgstr "Mật khẩu đã hết hạn. Hãy đổi mật khẩu trên máy chủ rồi thử lại."

#: rustconn/src/embedded_rdp/connection.rs:321
msgid ""
"This server requires Network Level Authentication.              The username "
"or password is likely incorrect — check your credentials and try again."
msgstr ""
"Máy chủ này yêu cầu Network Level Authentication. Tên người dùng hoặc mật "
"khẩu có thể không đúng — hãy kiểm tra thông tin đăng nhập rồi thử lại."

#: rustconn/src/embedded_rdp/connection.rs:328
msgid ""
"Connection failed: server is unreachable. Check the host address and port."
msgstr ""
"Kết nối thất bại: không thể truy cập máy chủ. Hãy kiểm tra địa chỉ và cổng "
"của máy chủ."

#: rustconn/src/embedded_rdp/connection.rs:345
msgid ""
"The server rejected the external client during the capabilities exchange. "
"This server (for example KRDP) only speaks the embedded client's protocol. "
"Set the connection's Client Mode to Embedded and connect again."
msgstr ""
"Máy chủ đã từ chối máy khách bên ngoài trong lúc trao đổi khả năng. Máy chủ "
"này (ví dụ KRDP) chỉ hỗ trợ giao thức của máy khách nhúng. Hãy đặt Chế độ "
"máy khách của kết nối thành Nhúng rồi kết nối lại."

#: rustconn/src/embedded_rdp/connection.rs:356
msgid "RDP connection failed ({}). Run with RUST_LOG=debug for details."
msgstr ""
"Kết nối RDP thất bại ({}). Hãy chạy với RUST_LOG=debug để xem chi tiết."

#: rustconn/src/embedded_rdp/connection.rs:660
msgid "FreeRDP {} is not supported. Install FreeRDP 3."
msgstr "FreeRDP {} không được hỗ trợ. Hãy cài đặt FreeRDP 3."

#: rustconn/src/embedded_rdp/connection.rs:668
msgid "RDP connection failed. Install FreeRDP 3 for external RDP sessions."
msgstr ""
"Kết nối RDP thất bại. Hãy cài đặt FreeRDP 3 cho các phiên RDP bên ngoài."

#: rustconn/src/embedded_rdp/connection.rs:731
msgid ""
"The embedded client does not support the legacy RDP security layer. Using "
"FreeRDP instead."
msgstr ""
"Máy khách nhúng không hỗ trợ lớp bảo mật RDP cũ. Sẽ dùng FreeRDP thay thế."

#: rustconn/src/embedded_rdp/connection.rs:734
msgid ""
"The embedded client does not support TLS without NLA. Using FreeRDP instead."
msgstr ""
"Máy khách nhúng không hỗ trợ TLS không có NLA. Sẽ dùng FreeRDP thay thế."

#: rustconn/src/embedded_rdp/connection.rs:737
msgid ""
"The embedded client does not support TLS security levels below 2. Using "
"FreeRDP instead."
msgstr ""
"Máy khách nhúng không hỗ trợ mức bảo mật TLS dưới 2. Sẽ dùng FreeRDP thay "
"thế."

#: rustconn/src/embedded_rdp/connection.rs:740
msgid "The embedded client does not support RemoteApp. Using FreeRDP instead."
msgstr "Máy khách nhúng không hỗ trợ RemoteApp. Sẽ dùng FreeRDP thay thế."

#: rustconn/src/embedded_rdp/connection.rs:743
msgid ""
"The embedded client does not support playing audio on the remote computer. "
"Using FreeRDP instead."
msgstr ""
"Máy khách nhúng không hỗ trợ phát âm thanh trên máy tính từ xa. Sẽ dùng "
"FreeRDP thay thế."

#: rustconn/src/embedded_rdp/connection.rs:746
msgid ""
"The embedded client does not support microphone redirection. Using FreeRDP "
"instead."
msgstr ""
"Máy khách nhúng không hỗ trợ chuyển hướng micrô. Sẽ dùng FreeRDP thay thế."

#: rustconn/src/embedded_rdp/connection.rs:873
#: rustconn/src/embedded_rdp/connection.rs:2978
msgid "Connection cancelled because the server requires legacy RDP security."
msgstr "Đã hủy kết nối vì máy chủ yêu cầu bảo mật RDP cũ."

#: rustconn/src/embedded_rdp/connection.rs:981
msgid ""
"Custom FreeRDP arguments are ignored by the embedded "
"client.                          Set the RDP client mode to External to "
"apply them."
msgstr ""
"Máy khách nhúng bỏ qua các đối số FreeRDP tùy chỉnh. Hãy đặt chế độ máy "
"khách RDP thành Bên ngoài để áp dụng chúng."

#: rustconn/src/embedded_rdp/connection.rs:2401
msgid "The server refused the shared folder “{}”"
msgstr "Máy chủ đã từ chối thư mục chia sẻ “{}”"

#: rustconn/src/embedded_rdp/connection.rs:2467
msgid ""
"H.264 is off — the installed OpenH264 isn't a Cisco build. Open Settings → "
"Connection → Media Codecs to download it."
msgstr ""
"H.264 đang tắt — OpenH264 đã cài đặt không phải bản dựng của Cisco. Hãy mở "
"Cài đặt → Kết nối → Codec đa phương tiện để tải xuống."

#: rustconn/src/embedded_rdp/connection.rs:2471
msgid ""
"H.264 is off — no OpenH264 codec is installed. Open Settings → Connection → "
"Media Codecs to download it."
msgstr ""
"H.264 đang tắt — chưa cài đặt codec OpenH264. Hãy mở Cài đặt → Kết nối → "
"Codec đa phương tiện để tải xuống."

#: rustconn/src/embedded_rdp/connection.rs:2475
msgid ""
"H.264 is off — the OpenH264 codec could not be loaded. Open Settings → "
"Connection → Media Codecs to re-download it."
msgstr ""
"H.264 đang tắt — không thể nạp codec OpenH264. Hãy mở Cài đặt → Kết nối → "
"Codec đa phương tiện để tải xuống lại."

#: rustconn/src/embedded_rdp/connection.rs:2685
msgid "Connection lost. Reconnecting (attempt {} of {})…"
msgstr "Mất kết nối. Đang kết nối lại (lần thử {} / {})…"

#: rustconn/src/embedded_rdp/connection.rs:3015
msgid "Could not prepare the external RDP compatibility client."
msgstr "Không thể chuẩn bị máy khách RDP tương thích bên ngoài."

#: rustconn/src/embedded_rdp/connection.rs:3026
msgid "Using external RDP client (server requires RDS licensing)"
msgstr "Đang dùng máy khách RDP bên ngoài (máy chủ yêu cầu cấp phép RDS)"

#: rustconn/src/embedded_rdp/connection.rs:3028
msgid "Using external RDP client (server incompatible)"
msgstr "Đang dùng máy khách RDP bên ngoài (máy chủ không tương thích)"

#: rustconn/src/embedded_rdp/connection.rs:3046
#: rustconn/src/embedded_rdp/connection.rs:3632
msgid "The external RDP client could not be started."
msgstr "Không thể khởi chạy máy khách RDP bên ngoài."

#: rustconn/src/embedded_rdp/connection.rs:3084
msgid ""
"Could not start the external RDP client. Install FreeRDP 3 and try again."
msgstr ""
"Không thể khởi chạy máy khách RDP bên ngoài. Hãy cài đặt FreeRDP 3 rồi thử "
"lại."

#: rustconn/src/embedded_rdp/connection.rs:3165
msgid "TLS connection failed. The server may not support this security level."
msgstr "Kết nối TLS thất bại. Máy chủ có thể không hỗ trợ mức bảo mật này."

#: rustconn/src/embedded_rdp/connection.rs:3169
msgid "Connection refused. Check host and port."
msgstr "Kết nối bị từ chối. Hãy kiểm tra máy chủ và cổng."

#: rustconn/src/embedded_rdp/connection.rs:3172
#: rustconn/src/embedded_web/mod.rs:653
msgid "Connection timed out. Check that the host is reachable."
msgstr ""
"Kết nối đã hết thời gian chờ. Hãy kiểm tra xem có truy cập được máy chủ "
"không."

#: rustconn/src/embedded_rdp/connection.rs:3193
msgid ""
"Authentication failed: invalid username or password. If the credentials are "
"correct and the server is a Linux RDP host (KDE KRdp, xrdp), this can "
"instead be the server's NLA regression with FreeRDP 3.32 — update KRdp to "
"6.7.90 or newer, or set ExtSecurity=0 on the server (FreeRDP issue #13567)."
msgstr ""
"Xác thực thất bại: tên người dùng hoặc mật khẩu không hợp lệ. Nếu thông tin "
"đăng nhập đúng và máy chủ là máy chủ RDP Linux (KDE KRdp, xrdp), đây có thể "
"là lỗi hồi quy NLA của máy chủ với FreeRDP 3.32 — hãy cập nhật KRdp lên "
"6.7.90 hoặc mới hơn, hoặc đặt ExtSecurity=0 trên máy chủ (FreeRDP issue "
"#13567)."

#: rustconn/src/embedded_rdp/connection.rs:3198
msgid ""
"Account restrictions refused this sign-in. Protected Users members cannot "
"use NTLM: turn on Kerberos Authentication in the connection's RDP settings."
msgstr ""
"Các hạn chế tài khoản đã từ chối lần đăng nhập này. Thành viên Protected "
"Users không thể dùng NTLM: hãy bật Xác thực Kerberos trong cài đặt RDP của "
"kết nối."

#: rustconn/src/embedded_rdp/connection.rs:3201
msgid "Authentication failed: account restrictions prevent this login."
msgstr "Xác thực thất bại: các hạn chế tài khoản ngăn lần đăng nhập này."

#: rustconn/src/embedded_rdp/connection.rs:3204
msgid "Authentication failed: password must be changed before first login."
msgstr "Xác thực thất bại: phải đổi mật khẩu trước lần đăng nhập đầu tiên."

#: rustconn/src/embedded_rdp/connection.rs:3206
msgid "Authentication failed: account is disabled."
msgstr "Xác thực thất bại: tài khoản đã bị vô hiệu hóa."

#: rustconn/src/embedded_rdp/connection.rs:3207
msgid "Authentication failed: account is locked out."
msgstr "Xác thực thất bại: tài khoản đang bị khóa."

#: rustconn/src/embedded_rdp/connection.rs:3208
msgid "Authentication failed: password has expired."
msgstr "Xác thực thất bại: mật khẩu đã hết hạn."

#: rustconn/src/embedded_rdp/connection.rs:3209
msgid "Authentication failed: account has expired."
msgstr "Xác thực thất bại: tài khoản đã hết hạn."

#: rustconn/src/embedded_rdp/connection.rs:3211
msgid "Authentication failed: account is disabled, locked out or expired."
msgstr "Xác thực thất bại: tài khoản đã bị vô hiệu hóa, bị khóa hoặc hết hạn."

#: rustconn/src/embedded_rdp/connection.rs:3214
msgid "Authentication failed: user is not allowed to log on to this computer."
msgstr ""
"Xác thực thất bại: người dùng không được phép đăng nhập vào máy tính này."

#: rustconn/src/embedded_rdp/connection.rs:3218
msgid ""
"No Kerberos KDC was found for the {} realm. Enter a KDC Address in the "
"connection's RDP settings or add the realm to /etc/krb5.conf."
msgstr ""
"Không tìm thấy Kerberos KDC cho realm {}. Hãy nhập Địa chỉ KDC trong cài đặt "
"RDP của kết nối hoặc thêm realm vào /etc/krb5.conf."

#: rustconn/src/embedded_rdp/connection.rs:3222
#: rustconn/src/embedded_rdp/connection.rs:3262
msgid ""
"Kerberos needs the DNS domain. Enter it in the Domain field, for example "
"EXAMPLE.COM."
msgstr ""
"Kerberos cần tên miền DNS. Hãy nhập vào trường Miền, ví dụ EXAMPLE.COM."

#: rustconn/src/embedded_rdp/connection.rs:3226
msgid ""
"Could not reach the Kerberos KDC. Enter a domain controller's name or IP "
"address as the KDC Address in the connection's RDP settings."
msgstr ""
"Không thể truy cập Kerberos KDC. Hãy nhập tên hoặc địa chỉ IP của bộ điều "
"khiển miền làm Địa chỉ KDC trong cài đặt RDP của kết nối."

#: rustconn/src/embedded_rdp/connection.rs:3229
msgid ""
"Kerberos sign-in failed: this computer's clock differs from the domain's by "
"more than five minutes. Synchronize the clock and try again."
msgstr ""
"Đăng nhập Kerberos thất bại: đồng hồ của máy tính này lệch với miền hơn năm "
"phút. Hãy đồng bộ đồng hồ rồi thử lại."

#: rustconn/src/embedded_rdp/connection.rs:3232
msgid ""
"The domain does not know this server by the name in Host. Connect by the "
"server's DNS name, as registered in the domain."
msgstr ""
"Miền không nhận biết máy chủ này theo tên trong ô Máy chủ. Hãy kết nối bằng "
"tên DNS của máy chủ, như đã đăng ký trong miền."

#: rustconn/src/embedded_rdp/connection.rs:3234
msgid "NLA authentication failed. Check username and password."
msgstr "Xác thực NLA thất bại. Hãy kiểm tra tên người dùng và mật khẩu."

#: rustconn/src/embedded_rdp/connection.rs:3256
msgid ""
"Kerberos needs the server's DNS name. Connecting by IP address or through an "
"SSH tunnel fails."
msgstr ""
"Kerberos cần tên DNS của máy chủ. Kết nối bằng địa chỉ IP hoặc qua đường hầm "
"SSH sẽ thất bại."

#: rustconn/src/embedded_rdp/connection.rs:3259
msgid ""
"Kerberos needs the DNS domain, for example EXAMPLE.COM, not the short domain "
"name."
msgstr ""
"Kerberos cần tên miền DNS, ví dụ EXAMPLE.COM, không phải tên miền rút gọn."

#: rustconn/src/embedded_rdp/connection.rs:3659
